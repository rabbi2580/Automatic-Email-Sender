# ---- Copy to .env and fill in. NEVER commit .env. ----
ENVIRONMENT=production                 # development | production
PUBLIC_BASE_URL=http://localhost:3000  # where the web app is served (used in emails + OAuth redirects)
API_BASE_URL=http://localhost:8000     # public URL of the API (used for signed download links + OAuth callbacks)
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---- Secrets (generate!) ----
# SECRET_KEY:     python -c "import secrets;print(secrets.token_urlsafe(48))"
# ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Losing ENCRYPTION_KEY makes stored OAuth tokens / SMTP passwords unreadable (users must reconnect).
SECRET_KEY=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=jobapply

# ---- AI provider: heuristic (no LLM, works offline) | openai | openai_compatible | anthropic | gemini ----
AI_PROVIDER=heuristic
AI_FALLBACK_TO_HEURISTIC=true
AI_CHEAP_MODEL=
AI_STRONG_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Google (sign-in + Gmail send). Redirect URIs:  {API_BASE_URL}/api/v1/auth/google/callback  and  {API_BASE_URL}/api/v1/integrations/email/callback/gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ---- Microsoft (Outlook send). Redirect URI: {API_BASE_URL}/api/v1/integrations/email/callback/outlook
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ---- Transactional email (verification links). Leave empty in dev: links are logged instead.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
SYSTEM_EMAIL_FROM=no-reply@example.com

# ---- Abuse prevention (sensible defaults) ----
RATE_LIMIT_BACKEND=redis               # memory (single process) | redis (required if you run >1 API process)
REDIS_URL=redis://redis:6379/0
TRUSTED_PROXY_HOPS=0                   # set to the number of reverse proxies you operate in front of the API (1 for one nginx/ALB)
EMAIL_SEND_PER_HOUR=15
EMAIL_SEND_PER_DAY=40
MAX_UPLOAD_MB=10
